  "rag-pipeline": {
    "title": {
      "de": "Hybrid RAG & int8-Vektorsuche in Cloudflare D1 + NotebookDO",
      "en": "Hybrid RAG & int8 vector search in Cloudflare D1 + NotebookDO"
    },
    "desc": {
      "de": "Fünfstufige Pipeline: 1. Browser-Chunking, 2. 768d Embeddings und symmetrische int8-Quantisierung, 3. Speicherung in D1 + FTS5-Index, 4. Hybrid-Suche via NotebookDO In-Memory Dot-Product und D1 FTS5 BM25 mit Reciprocal Rank Fusion, 5. Zitat-validierter SSE-Chat.",
      "en": "Five-stage pipeline: 1. browser chunking, 2. 768d embeddings and symmetric int8 quantization, 3. storage in D1 + FTS5 index, 4. hybrid search via NotebookDO in-memory dot product and D1 FTS5 BM25 with Reciprocal Rank Fusion, 5. citation-validated SSE chat."
    },
    "texts": {
      "t01": {
        "de": "Hybrid-RAG-Pipeline: 768d int8-Quantisierung + D1 FTS5 BM25 + Reciprocal Rank Fusion (RRF)",
        "en": "Hybrid RAG pipeline: 768d int8 quantization + D1 FTS5 BM25 + Reciprocal Rank Fusion (RRF)"
      },
      "t02": {
        "de": "75 % Speicherersparnis gegenüber Float32 · 0 ms Worker-CPU-Belastung beim Vektor-Scoring · Recall@10 ≥ 0,98",
        "en": "75 % less storage than Float32 · 0 ms Worker CPU load for vector scoring · Recall@10 ≥ 0.98"
      },
      "t03": {
        "de": "1. Browser-Ingest",
        "en": "1. Browser ingest"
      },
      "t04": {
        "de": "• PDF / DOCX / MD / OCR",
        "en": "• PDF / DOCX / MD / OCR"
      },
      "t05": {
        "de": "• Im Web Worker geparst",
        "en": "• Parsed in a Web Worker"
      },
      "t06": {
        "de": "• Token-bewusstes Chunking:",
        "en": "• Token-aware chunking:"
      },
      "t07": {
        "de": "  ≈ 800 Tokens / Chunk",
        "en": "  ≈ 800 tokens / chunk"
      },
      "t08": {
        "de": "  100 Tokens Überlappung",
        "en": "  100 tokens overlap"
      },
      "t09": {
        "de": "• Metadaten je Chunk:",
        "en": "• Metadata per chunk:"
      },
      "t10": {
        "de": "  page, start_ms, ord",
        "en": "  page, start_ms, ord"
      },
      "t11": {
        "de": "2. 768d → int8 Quant",
        "en": "2. 768d → int8 Quant"
      },
      "t12": {
        "de": "• gemini-embedding-001",
        "en": "• gemini-embedding-001"
      },
      "t13": {
        "de": "  oder nomic-embed-text",
        "en": "  or nomic-embed-text"
      },
      "t14": {
        "de": "• Symmetrische Quantisierung:",
        "en": "• Symmetric quantization:"
      },
      "t15": {
        "de": "scale = max(|v_i|) / 127",
        "en": "scale = max(|v_i|) / 127"
      },
      "t16": {
        "de": "q_i = round(v_i / scale)",
        "en": "q_i = round(v_i / scale)"
      },
      "t17": {
        "de": "• Float32: 3.072 Bytes",
        "en": "• Float32: 3,072 bytes"
      },
      "t18": {
        "de": "• Int8 BLOB: 768 Bytes (-75%)",
        "en": "• Int8 BLOB: 768 bytes (-75%)"
      },
      "t19": {
        "de": "3. D1 Persistenz & FTS5",
        "en": "3. D1 persistence & FTS5"
      },
      "t20": {
        "de": "• Tabelle chunks (Text, Seite)",
        "en": "• Table chunks (text, page)"
      },
      "t21": {
        "de": "• Tabelle chunk_vectors:",
        "en": "• Table chunk_vectors:"
      },
      "t22": {
        "de": "  768-Byte BLOB + scale REAL",
        "en": "  768-byte BLOB + scale REAL"
      },
      "t23": {
        "de": "• Virtuelle Tabelle chunks_fts:",
        "en": "• Virtual table chunks_fts:"
      },
      "t24": {
        "de": "  USING fts5(unicode61)",
        "en": "  USING fts5(unicode61)"
      },
      "t25": {
        "de": "  Sync-Trigger (AI / AU / AD)",
        "en": "  Sync triggers (AI / AU / AD)"
      },
      "t26": {
        "de": "• 5.000 Chunks ≈ 3,8 MB",
        "en": "• 5,000 chunks ≈ 3.8 MB"
      },
      "t27": {
        "de": "4. Hybrid RRF Suche",
        "en": "4. Hybrid RRF search"
      },
      "t28": {
        "de": "• Pfad A (Semantisch):",
        "en": "• Path A (semantic):"
      },
      "t29": {
        "de": "  NotebookDO hält Int8Array",
        "en": "  NotebookDO keeps Int8Array"
      },
      "t30": {
        "de": "  im RAM → Dot-Product < 3 ms",
        "en": "  in RAM → dot product < 3 ms"
      },
      "t31": {
        "de": "• Pfad B (Lexikalisch):",
        "en": "• Path B (lexical):"
      },
      "t32": {
        "de": "  D1 FTS5 MATCH + bm25()",
        "en": "  D1 FTS5 MATCH + bm25()"
      },
      "t33": {
        "de": "• Fusion via RRF (k=60):",
        "en": "• Fusion via RRF (k=60):"
      },
      "t34": {
        "de": "1/(60+r_vec) + 1/(60+r_fts)",
        "en": "1/(60+r_vec) + 1/(60+r_fts)"
      },
      "t35": {
        "de": "5. Grounded Chat",
        "en": "5. Grounded Chat"
      },
      "t36": {
        "de": "• Top-k Chunks als",
        "en": "• Top-k chunks as"
      },
      "t37": {
        "de": "  nummerierter Kontext",
        "en": "  numbered context"
      },
      "t38": {
        "de": "• Halluzinations-Check:",
        "en": "• Hallucination check:"
      },
      "t39": {
        "de": "  Jedes [n]-Zitat wird gegen",
        "en": "  every [n] citation is checked"
      },
      "t40": {
        "de": "  reale Chunk-IDs geprüft",
        "en": "  against real chunk IDs"
      },
      "t41": {
        "de": "• 1-Klick-Sprung zur",
        "en": "• One-click jump to the"
      },
      "t42": {
        "de": "  Fundstelle / Zeitmarke",
        "en": "  passage / timestamp"
      }
    }
  },
  "relationflow-bridge": {
    "title": {
      "de": "Andock-Architektur an Everlast RelationFlow",
      "en": "Docking architecture for Everlast RelationFlow"
    },
    "desc": {
      "de": "Zeigt die nahtlose Integration des NotebookLM-Klons als Wissens-, RAG- und Studio-Modul in die RelationFlow-Plattform über Workspaces, Rollen (Owner, Editor, Viewer), Auto-LLM-Router und die dedizierte /api/v1/notebooks/:id/search Schnittstelle.",
      "en": "Shows how the NotebookLM clone plugs into the RelationFlow platform as a knowledge, RAG and Studio module via workspaces, roles (Owner, Editor, Viewer), an auto LLM router and the dedicated /api/v1/notebooks/:id/search endpoint."
    },
