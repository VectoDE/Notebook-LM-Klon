  "security-layers": {
    "title": {
      "de": "Defense-in-Depth Sicherheits-, Datenschutz- und Compliance-Schichten",
      "en": "Defense-in-depth security, privacy and compliance layers"
    },
    "desc": {
      "de": "Vier Sicherheits- und Rechts-Säulen: 1. Edge- & Transport-Sicherheit (Turnstile, CSP, Trusted Types, HSTS), 2. Authentifizierung & Kryptografie (WebAuthn Passkeys, AES-256-GCM BYOK Envelope Encryption, SSRF-Guard), 3. EU-Recht & Datenschutz (DSGVO Art. 15/17/20, EU AI Act Art. 50, TDDDG, DDG), 4. Barrierefreiheit & Supply-Chain (WCAG 2.2 AAA, OpenSSF Scorecard, CodeQL, osv-scanner).",
      "en": "Four security and legal pillars: 1. edge & transport security (Turnstile, CSP, Trusted Types, HSTS), 2. authentication & cryptography (WebAuthn passkeys, AES-256-GCM BYOK envelope encryption, SSRF guard), 3. EU law & data protection (GDPR Art. 15/17/20, EU AI Act Art. 50, TDDDG, DDG), 4. accessibility & supply chain (WCAG 2.2 AAA, OpenSSF Scorecard, CodeQL, osv-scanner)."
    },
    "texts": {
      "t01": {
        "de": "Defense-in-Depth: Security, DSGVO, EU AI Act Art. 50 & WCAG 2.2 AAA",
        "en": "Defense in depth: security, GDPR, EU AI Act Art. 50 & WCAG 2.2 AAA"
      },
      "t02": {
        "de": "Security by Design & Privacy by Default · Null unverschlüsselte API-Keys · Null Tracking-Cookies · Vollständige Supply-Chain-Prüfung",
        "en": "Security by design & privacy by default · Zero unencrypted API keys · Zero tracking cookies · Full supply-chain checks"
      },
      "t03": {
        "de": "1. Edge & Browser Hardening",
        "en": "1. Edge & Browser Hardening"
      },
      "t04": {
        "de": "• Strikte Content-Security-Policy",
        "en": "• Strict Content Security Policy"
      },
      "t05": {
        "de": "  object-src 'none', base-uri 'none'",
        "en": "  object-src 'none', base-uri 'none'"
