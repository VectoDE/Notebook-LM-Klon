{
  "name": "notebook-lm-klon",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first, accessible NotebookLM clone running on a single Cloudflare Worker with D1, R2, and Durable Objects.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.13.4",
    "@vitest/coverage-v8": "3.0.6",
    "typescript": "5.7.3",
    "vitest": "3.0.6"
  }
}
