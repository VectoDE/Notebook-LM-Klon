{
  "name": "notebook-lm-klon",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first, accessible NotebookLM clone running on a single Cloudflare Worker with D1, R2, and Durable Objects.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@hono/node-server": "2.1.6",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "^4.10.2",
    "typescript": "5.8.3",
    "vitest": "5.1.0"
  }
}
