{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "notebook-lm-klon",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "APP_PROFILE": "demo",
    "APP_ORIGIN": "http://localhost:8787"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notebook-lm-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "notebook-lm-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTEBOOK_DO",
        "class_name": "NotebookDO"
      },
      {
        "name": "JOB_DO",
        "class_name": "JobDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NotebookDO", "JobDO"]
    }
  ]
}
