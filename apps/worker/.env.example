# Template for local Node/Docker runs. Copy to `.env` in the repository root (ignored by git; docker compose reads it there) and fill in your own values.
# Values stay empty on purpose: an empty secret counts as missing, so a copied template
# never runs with a known key. Never commit real secrets.
# Generate each secret with: openssl rand -hex 32
# Cloudflare: set the same names with `wrangler secret put <NAME>` instead.

# Salt for hashing IP and User-Agent in sessions. Missing → login answers 503.
SESSION_SALT_SECRET=

# Key-encryption key for stored BYOK API keys (at least 32 characters).
# Missing or too short → /api/v1/keys answers 503 and stores nothing.
KEK_V1=

# Rotation only: add the new key as KEK_V2, then set KEK_CURRENT_VERSION=2.
KEK_V2=
KEK_CURRENT_VERSION=

# Cloudflare Turnstile (bot check before guest login and magic link).
# Missing → guest login and magic link answer 503 TURNSTILE_NOT_CONFIGURED (fail-closed).
# TEST ONLY, never in production: secret 1x0000000000000000000000000000000AA
# with site key 1x00000000000000000000AA (both always pass).
TURNSTILE_SECRET_KEY=
# Public site key, built into the web app: docker compose passes it as build argument.
VITE_TURNSTILE_SITE_KEY=

# Public address of the instance (scheme, host, port; no path). Default: http://localhost:8787
APP_ORIGIN=
# demo (default) or full
APP_PROFILE=

# Mail: SMTP is used when SMTP_HOST is set, otherwise Resend. Both need MAIL_FROM.
MAIL_FROM=
SMTP_HOST=
# Default 587 with mandatory STARTTLS; 465 = implicit TLS.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Only behind a reverse proxy that writes this header (see README, TRUSTED_PROXY_HEADER).
TRUSTED_PROXY_HEADER=

# Hourly cleanup in the server (minutes). 0 = external cron runs "node-server.js cleanup".
CLEANUP_INTERVAL_MINUTES=

# C2PA provenance for exports (docs/c2pa.md). All three are needed, otherwise exports stay unsigned.
# Never commit the key file. C2PA_CERT_KIND=production only with your own certificate.
C2PATOOL_PATH=
C2PA_SIGN_CERT=
C2PA_PRIVATE_KEY=
C2PA_CERT_KIND=
C2PA_TSA_URL=
