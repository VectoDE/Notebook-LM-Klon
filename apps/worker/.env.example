# Template for local Node/Docker runs. Copy to `.env` in the repository root (ignored by git; docker compose reads it there) and fill in your own values.
# Values stay empty on purpose: an empty secret counts as missing, so a copied template
# never runs with a known key. Never commit real secrets.
# Generate each secret with: openssl rand -hex 32
# Cloudflare: set the same names with `wrangler secret put <NAME>` instead.

# Salt for hashing IP and User-Agent in sessions. Missing → login answers 503.
SESSION_SALT_SECRET=

# Key-encryption key for stored BYOK API keys (at least 32 characters).
# Missing or too short → /api/v1/keys answers 503 and stores nothing.
KEK_V1=

# Rotation only: add the new key as KEK_V2, then set KEK_CURRENT_VERSION=2.
KEK_V2=
KEK_CURRENT_VERSION=
